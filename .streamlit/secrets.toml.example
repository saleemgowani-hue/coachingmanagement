# Copy this file to secrets.toml (same folder) for LOCAL testing of the
# online/Postgres mode, or paste these same keys into
# Streamlit Community Cloud -> App Settings -> Secrets when deploying.
#
# secrets.toml itself is in .gitignore and must NEVER be committed -
# only this .example file (with placeholder values) is meant for git.

DB_BACKEND = "postgres"
DATABASE_URL = "postgresql://user:password@host:5432/database_name"

COMPANY_NAME = "SN Softech Solutions"
PRODUCT_NAME = "SN Coaching Management System"
SUPPORT_EMAIL = "support@yourcompany.com"
SUPPORT_WHATSAPP = "9993199719"

MONTHLY_PRICE = "999"
YEARLY_PRICE = "9999"

DEMO_USERNAME = "demo"
DEMO_PASSWORD = "change-this-demo-password"
DEMO_INSTITUTE_NAME = "Demo Coaching Centre"

SUPER_ADMIN_USERNAME = "superadmin"
SUPER_ADMIN_PASSWORD = "change-this-to-a-strong-unique-password"
